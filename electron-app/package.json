{
  "name": "bcr-analysis",
  "version": "1.1.0",
  "description": "B-Cell Repertoire Analysis Tool",
  "author": "Cada Health",
  "repository": {
    "type": "git",
    "url": "https://github.com/CadaHealth/AutoAB.git"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:preload\" \"npm run dev:renderer\" \"wait-on dist/main/index.js dist/preload/index.js http://localhost:5173 && npm run start\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:preload": "tsc -p tsconfig.preload.json --watch",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "build:web": "vite build",
    "preview:web": "vite build && npx serve dist/renderer",
    "start": "electron .",
    "preview": "npm run build && electron .",
    "bundle:python": "bash ../scripts/bundle-python.sh",
    "bundle:deps": "bash ../scripts/install.sh && bash ../scripts/bundle-python.sh",
    "package": "npm run build && electron-builder --publish never",
    "package:mac": "bash ../scripts/install.sh && bash ../scripts/bundle-python.sh --all && npm run build && electron-builder --mac --x64 --arm64 --publish never",
    "package:mac:arm64": "bash ../scripts/install.sh && bash ../scripts/bundle-python.sh --arch arm64 && npm run build && electron-builder --mac --arm64 --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "test:e2e": "npm run build && node scripts/e2e-run.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "electron-store": "^8.1.0",
    "fflate": "^0.8.2",
    "html2canvas": "^1.4.1",
    "phylotree": "^2.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@tsconfig/svelte": "^5.0.2",
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "playwright": "^1.62.0",
    "svelte": "^4.2.8",
    "svelte-check": "^3.6.2",
    "svelte-preprocess": "^6.0.3",
    "typescript": "^5.3.2",
    "vite": "^5.0.6",
    "wait-on": "^7.2.0"
  }
}
